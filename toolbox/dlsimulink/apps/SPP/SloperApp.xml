<?xml version="1.0" encoding="UTF-8"?>
<UI desc="MainLayout">
  <grid-layout class="matlab.ui.container.GridLayout" id="MainGrid">
    <row-height value="1x"/>
    <column-width value="1x"/>
    <padding left="0" right="0" top="0" bottom="0"/>
    <spacing row="0" column="0"/>
    <children>
      <tab-group class="matlab.ui.container.TabGroup" id="TabGroup" tabLocation="top">
        <tabs>

          <tab class="matlab.ui.container.Tab" id="ImportTab" title="Import Data">
            <children>
              <grid-layout class="matlab.ui.container.GridLayout" id="ImportGrid">
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="80"/>
                <row-height value="80"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <row-height value="fit"/>
                <column-width value="fit"/>
                <column-width value="250"/>
                <padding left="10" right="10" top="10" bottom="10"/>
                <spacing row="5" column="5"/>
                <children>
                  <button class="matlab.ui.control.Button" id="FileButton" text="Browse File..." tooltip="Select ANSYS .txt file">
                    <callback event="ButtonPushed" method="FileButtonPushed"/>
                    <layout row="1" column="1"/>
                  </button>
                  <edit-field class="matlab.ui.control.EditField" id="FilePathField" editable="false" value="">
                    <layout row="1" column="2"/>
                  </edit-field>
                  <label class="matlab.ui.control.Label" id="DatasetNameLabel" text="Dataset Name:">
                    <layout row="2" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="DatasetNameField" value="">
                    <layout row="2" column="2"/>
                  </edit-field>
                  <drop-down class="matlab.ui.control.DropDown" id="DataTypeDropdown" items="2D;1D" value="2D" tooltip="Select data type (2D surface or 1D profile)">
                    <callback event="ValueChanged" method="DataTypeDropdownChanged"/>
                    <layout row="3" column="1"/>
                  </drop-down>
                  <drop-down class="matlab.ui.control.DropDown" id="DirectionDropdown" items="Sagittal;Longitudinal" value="Sagittal" enabled="false" tooltip="Select profile direction for 1D data">
                    <layout row="3" column="2"/>
                  </drop-down>
                  <button class="matlab.ui.control.Button" id="AddDatasetButton" text="Add Dataset" buttonStyle="primary">
                    <callback event="ButtonPushed" method="AddDatasetButtonPushed"/>
                    <layout row="4" column="1" columnSpan="2"/>
                  </button>
                  <list-box class="matlab.ui.control.ListBox" id="DatasetListBox" items="">
                    <callback event="ValueChanged" method="DatasetListBoxChanged"/>
                    <layout row="5" column="1" rowSpan="2" columnSpan="2"/>
                  </list-box>
                  <button class="matlab.ui.control.Button" id="RemoveDatasetButton" text="Remove Dataset">
                    <callback event="ButtonPushed" method="RemoveDatasetButtonPushed"/>
                    <layout row="7" column="1" columnSpan="2"/>
                  </button>
                  <label text="Export Directory:" fontWeight="bold">
                    <layout row="8" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="ExportDirField" editable="false" value="">
                    <layout row="8" column="2"/>
                  </edit-field>
                  <button class="matlab.ui.control.Button" id="BrowseExportDirButton" text="Browse...">
                    <callback event="ButtonPushed" method="BrowseExportDirButtonPushed"/>
                    <layout row="9" column="1" columnSpan="2"/>
                  </button>
                  <label text="dver:" fontWeight="bold">
                    <layout row="10" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="DverField" value="TEST">
                    <layout row="10" column="2"/>
                  </edit-field>
                  <label text="blname:" fontWeight="bold">
                    <layout row="11" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="BlnameField" value="X">
                    <layout row="11" column="2"/>
                  </edit-field>
                  <label text="optname:" fontWeight="bold">
                    <layout row="12" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="OptnameField" value="X">
                    <layout row="12" column="2"/>
                  </edit-field>
                  <label text="scename:" fontWeight="bold">
                    <layout row="13" column="1"/>
                  </label>
                  <edit-field class="matlab.ui.control.EditField" id="ScenameField" value="X">
                    <layout row="13" column="2"/>
                  </edit-field>
                  <label text="Dataset to Export:" fontWeight="bold">
                    <layout row="14" column="1"/>
                  </label>
                  <drop-down class="matlab.ui.control.DropDown" id="ExportDatasetDropdown" items="">
                    <callback event="ValueChanged" method="ExportDatasetDropdownChanged"/>
                    <layout row="14" column="2"/>
                  </drop-down>
                  <label text="Note: Data must be in mm units." fontWeight="bold">
                    <layout row="15" column="1" columnSpan="2"/>
                  </label>
                  <button class="matlab.ui.control.Button" id="ImportExportButton" text="Export Data" buttonStyle="primary">
                    <callback event="ButtonPushed" method="ExportButtonPushed"/>
                    <layout row="16" column="1" columnSpan="2"/>
                  </button>
                  <label class="matlab.ui.control.Label" id="ExportStatusLabel" text="Ready" fontWeight="bold">
                    <layout row="17" column="1" columnSpan="2"/>
                  </label>
                </children>
              </grid-layout>
            </children>
          </tab>

          <tab class="matlab.ui.container.Tab" id="AnalysisTab" title="Analysis">
            <children>
              <grid-layout class="matlab.ui.container.GridLayout" id="AnalysisGrid">
                <row-height value="1x"/>
                <column-width value="220"/>
                <column-width value="1x"/>
                <padding left="5" right="5" top="5" bottom="5"/>
                <spacing row="0" column="5"/>
                <children>

                  <grid-layout class="matlab.ui.container.GridLayout" id="ParamPanel">
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <column-width value="fit"/>
                    <column-width value="1x"/>
                    <padding left="5" right="5" top="5" bottom="5"/>
                    <spacing row="5" column="5"/>
                    <children>
                      <label text="Dataset:" fontWeight="bold">
                        <layout row="1" column="1"/>
                      </label>
                      <drop-down class="matlab.ui.control.DropDown" id="DatasetDropdown" items="">
                        <callback event="ValueChanged" method="DatasetDropdownChanged"/>
                        <layout row="1" column="2"/>
                      </drop-down>
                      <label text="Nxx:">
                        <layout row="2" column="1"/>
                      </label>
                      <spinner class="matlab.ui.control.Spinner" id="NxxField" value="100" step="1" limits="1,inf">
                        <callback event="ValueChanged" method="ParamChanged"/>
                        <layout row="2" column="2"/>
                      </spinner>
                      <label text="Nyy:">
                        <layout row="3" column="1"/>
                      </label>
                      <spinner class="matlab.ui.control.Spinner" id="NyyField" value="20" step="1" limits="1,inf">
                        <callback event="ValueChanged" method="ParamChanged"/>
                        <layout row="3" column="2"/>
                      </spinner>
                      <label text="Np:">
                        <layout row="4" column="1"/>
                      </label>
                      <spinner class="matlab.ui.control.Spinner" id="NpField" value="10" step="1" limits="1,inf">
                        <callback event="ValueChanged" method="ParamChanged"/>
                        <layout row="4" column="2"/>
                      </spinner>
                      <label text="Order:">
                        <layout row="5" column="1"/>
                      </label>
                      <spinner class="matlab.ui.control.Spinner" id="OrderField" value="3" step="1" limits="1,inf" enabled="false">
                        <callback event="ValueChanged" method="ParamChanged"/>
                        <layout row="5" column="2"/>
                      </spinner>
                      <check-box class="matlab.ui.control.CheckBox" id="FIDCheckBox" text="FID (Polynomial Fit)" value="false">
                        <callback event="ValueChanged" method="FIDChanged"/>
                        <layout row="6" column="1" columnSpan="2"/>
                      </check-box>
                      <check-box class="matlab.ui.control.CheckBox" id="SymCheckBox" text="Sym (Mirror Grid)" value="false">
                        <callback event="ValueChanged" method="ParamChanged"/>
                        <layout row="7" column="1" columnSpan="2"/>
                      </check-box>
                      <label text="Deformation units:" fontWeight="bold">
                        <layout row="8" column="1" columnSpan="2"/>
                      </label>
                      <grid-layout class="matlab.ui.container.GridLayout" id="UnitGrid">
                        <row-height value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <padding left="0" right="0" top="0" bottom="0"/>
                        <spacing row="0" column="0"/>
                        <layout row="9" column="1" columnSpan="2"/>
                        <children>
                          <button class="matlab.ui.control.Button" id="UnitMM" text="mm">
                            <callback event="ButtonPushed" method="UnitChanged"/>
                            <layout row="1" column="1"/>
                          </button>
                          <button class="matlab.ui.control.Button" id="UnitUM" text="µm">
                            <callback event="ButtonPushed" method="UnitChanged"/>
                            <layout row="1" column="2"/>
                          </button>
                          <button class="matlab.ui.control.Button" id="UnitNM" text="nm">
                            <callback event="ButtonPushed" method="UnitChanged"/>
                            <layout row="1" column="3"/>
                          </button>
                        </children>
                      </grid-layout>
                      <label text="Stats [urad]:" fontWeight="bold">
                        <layout row="10" column="1" columnSpan="2"/>
                      </label>
                      <label text="       Sag       Lon" fontWeight="bold">
                        <layout row="11" column="1" columnSpan="2"/>
                      </label>
                      <grid-layout class="matlab.ui.container.GridLayout" id="StatsGrid">
                        <row-height value="fit"/>
                        <row-height value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <padding left="0" right="0" top="0" bottom="0"/>
                        <spacing row="2" column="5"/>
                        <layout row="12" column="1" rowSpan="2" columnSpan="2"/>
                        <children>
                          <label text="RMS:" fontWeight="bold">
                            <layout row="1" column="1"/>
                          </label>
                          <label class="matlab.ui.control.Label" id="StatsLabelSagRMS" text="--">
                            <layout row="1" column="2"/>
                          </label>
                          <label class="matlab.ui.control.Label" id="StatsLabelLonRMS" text="--">
                            <layout row="1" column="3"/>
                          </label>
                          <label text="STD:" fontWeight="bold">
                            <layout row="2" column="1"/>
                          </label>
                          <label class="matlab.ui.control.Label" id="StatsLabelSagSTD" text="--">
                            <layout row="2" column="2"/>
                          </label>
                          <label class="matlab.ui.control.Label" id="StatsLabelLonSTD" text="--">
                            <layout row="2" column="3"/>
                          </label>
                        </children>
                      </grid-layout>
                      <button class="matlab.ui.control.Button" id="RunButton" text="Run Analysis" buttonStyle="primary">
                        <callback event="ButtonPushed" method="RunButtonPushed"/>
                        <layout row="14" column="1"/>
                      </button>
                      <button class="matlab.ui.control.Button" id="ExportDataButton" text="Export Data" buttonStyle="primary">
                        <callback event="ButtonPushed" method="ExportButtonPushed"/>
                        <layout row="14" column="2"/>
                      </button>
                      <label class="matlab.ui.control.Label" id="AnalysisStatusLabel" text="Ready" fontWeight="bold">
                        <layout row="15" column="1" columnSpan="2"/>
                      </label>
                    </children>
                  </grid-layout>

                  <grid-layout class="matlab.ui.container.GridLayout" id="plotStack">
                    <row-height value="1x"/>
                    <row-height value="1x"/>
                    <column-width value="1x"/>
                    <padding left="5" right="5" top="5" bottom="5"/>
                    <spacing row="3" column="0"/>
                    <children>
                      <grid-layout class="matlab.ui.container.GridLayout" id="TopPlotGroup">
                        <row-height value="1x"/>
                        <row-height value="1x"/>
                        <column-width value="1x"/>
                        <padding left="2" right="2" top="2" bottom="2"/>
                        <spacing row="2" column="0"/>
                        <children>
                          <axes class="matlab.graphics.axis.Axes" id="ContourPlotSag" title="Sagittal Slope [urad]">
                            <layout row="1" column="1"/>
                          </axes>
                          <axes class="matlab.graphics.axis.Axes" id="ContourPlotLon" title="Longitudinal Slope [urad]">
                            <layout row="2" column="1"/>
                          </axes>
                        </children>
                      </grid-layout>
                      <grid-layout class="matlab.ui.container.GridLayout" id="BottomPlotGroup">
                        <row-height value="1x"/>
                        <row-height value="1x"/>
                        <column-width value="1x"/>
                        <column-width value="1x"/>
                        <padding left="2" right="2" top="2" bottom="2"/>
                        <spacing row="2" column="2"/>
                        <children>
                          <axes class="matlab.graphics.axis.Axes" id="LinePlotAx1">
                            <layout row="1" column="1"/>
                          </axes>
                          <axes class="matlab.graphics.axis.Axes" id="LinePlotAx2">
                            <layout row="1" column="2"/>
                          </axes>
                          <axes class="matlab.graphics.axis.Axes" id="LinePlotAx3">
                            <layout row="2" column="1"/>
                          </axes>
                          <axes class="matlab.graphics.axis.Axes" id="LinePlotAx4">
                            <layout row="2" column="2"/>
                          </axes>
                        </children>
                      </grid-layout>
                    </children>
                  </grid-layout>

                </children>
              </grid-layout>
            </children>
          </tab>

<tab class="matlab.ui.container.Tab" id="ComparisonTab" title="Comparison">
            <children>
              <grid-layout class="matlab.ui.container.GridLayout" id="ComparisonGrid">
                <row-height value="1x"/>
                <column-width value="220"/>
                <column-width value="1x"/>
                <padding left="5" right="5" top="5" bottom="5"/>
                <spacing row="0" column="5"/>
                <children>

                  <grid-layout class="matlab.ui.container.GridLayout" id="CompLeftGrid">
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="fit"/>
                    <row-height value="200"/>
                    <row-height value="1x"/>
                    <column-width value="1x"/>
                    <padding left="0" right="0" top="0" bottom="0"/>
                    <spacing row="3" column="0"/>
                    <children>

                      <button class="matlab.ui.control.Button" id="CompareButton" text="Compare" buttonStyle="primary">
                        <callback event="ButtonPushed" method="CompareButtonPushed"/>
                        <layout row="1" column="1"/>
                      </button>

                      <label text="Deformation units:" fontWeight="bold">
                        <layout row="2" column="1"/>
                      </label>

                      <grid-layout class="matlab.ui.container.GridLayout" id="CompUnitGrid">
                        <row-height value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <column-width value="fit"/>
                        <padding left="0" right="0" top="0" bottom="0"/>
                        <spacing row="0" column="0"/>
                        <layout row="3" column="1"/>
                        <children>
                          <button class="matlab.ui.control.Button" id="CompUnitMM" text="mm">
                            <callback event="ButtonPushed" method="CompUnitChanged"/>
                            <layout row="1" column="1"/>
                          </button>
                          <button class="matlab.ui.control.Button" id="CompUnitUM" text="µm">
                            <callback event="ButtonPushed" method="CompUnitChanged"/>
                            <layout row="1" column="2"/>
                          </button>
                          <button class="matlab.ui.control.Button" id="CompUnitNM" text="nm">
                            <callback event="ButtonPushed" method="CompUnitChanged"/>
                            <layout row="1" column="3"/>
                          </button>
                        </children>
                      </grid-layout>

                      <label text="Note: Only 1D datasets shown." fontWeight="bold">
                        <layout row="4" column="1"/>
                      </label>

                      <tree class="matlab.ui.container.Tree" id="CompTree">
                        <layout row="5" column="1"/>
                      </tree>

                    </children>
                  </grid-layout>

                  <grid-layout class="matlab.ui.container.GridLayout" id="CompPlotGrid">
                    <row-height value="1x"/>
                    <row-height value="1x"/>
                    <column-width value="1x"/>
                    <padding left="2" right="2" top="2" bottom="2"/>
                    <spacing row="3" column="0"/>
                    <children>
                      <axes class="matlab.graphics.axis.Axes" id="CompDeformationAx" title="Deformation Comparison">
                        <layout row="1" column="1"/>
                      </axes>
                      <axes class="matlab.graphics.axis.Axes" id="CompSlopeAx" title="Slope Comparison [urad]">
                        <layout row="2" column="1"/>
                      </axes>
                    </children>
                  </grid-layout>

                </children>
              </grid-layout>
            </children>
          </tab>

        </tabs>
      </tab-group>
    </children>
  </grid-layout>
</UI>